# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres. Use the Supabase *transaction pooler* URL (port 6543), not the direct one,
# so serverless instances don't exhaust the connection limit.
# Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Google OAuth (Google Cloud Console → Credentials → Web client)
# Add `${API_URL}/auth/google/callback` to that client's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of this API, no trailing slash. Used to build the Google redirect URI.
API_URL=http://localhost:3000

# Deep-link URIs the Google callback may redirect to, comma separated.
ALLOWED_REDIRECT_URIS=routewise://

# Local dev only
PORT=3000

# debug | info | warn | error (default: info in production, debug otherwise)
LOG_LEVEL=debug
