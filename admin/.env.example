# Backend API base URL, no trailing slash (see backend/README.md).
# Local: http://localhost:3000   Production: https://<your-backend-vercel-domain>
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase (Project Settings → API). Used only for admin login; both values are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps JavaScript API key for the map editor (browser key, restrict it by HTTP referrer).
NEXT_PUBLIC_GMAPS_API=
