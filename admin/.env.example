# Supabase (Project Settings → API). The NEXT_PUBLIC_ ones are sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this one.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres, used by the /api routes (route editing, database tables).
# Prefer the transaction pooler URL (port 6543) on Vercel; DATABASE_URL is the fallback.
# Project Settings → Database → Connection string
DATABASE_POOLER_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Google Maps JavaScript API key for the map editor (browser key, restrict it by HTTP referrer).
NEXT_PUBLIC_GMAPS_API=
