     latitude: position.coordinates.latitude,
     longitude: position.coordinates.longitude
   )
+  // RouteWise patch: with a bearing, a rotated top-down camera instead of a north-up region.
+  // The camera distance roughly matches the zoom level's visible width.
+  if let bearing = position.bearing {
+    let widthMeters = 360 / pow(2, position.zoom) * 111_320 * cos(coordinate.latitude * .pi / 180)
+    return .camera(
+      MapCamera(centerCoordinate: coordinate, distance: widthMeters * 1.6, heading: bearing, pitch: 0)
+    )
+  }
   return convertToMapCameraPosition(coordinate: coordinate, zoom: position.zoom)
 }
 
